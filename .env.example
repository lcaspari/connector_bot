# Telegram Bot Configuration
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# Cron Job Security
CRON_SECRET=change-me-to-something-secure

# Group Configuration
GROUP_CHAT_ID=your-group-chat-id-here

# Scheduling Configuration
CALL_HOUR=19
CALL_MINUTE=0
TIMEZONE=Europe/Berlin

# Testing Configuration (set to 'true' to bypass Monday restriction)
TEST_MODE=false

# Database Configuration (optional)
DATABASE=connector_bot.db

